{
  "appId": "com.shadowslayer.liquorcabinet",
  "appName": "Liquor Cabinet",
  "webDir": "dist",
  "android": {
    "backgroundColor": "#070504"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK",
      "initialViewportFitValueHint": "cover"
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#070504",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_liquor",
      "iconColor": "#D4872A"
    }
  }
}
