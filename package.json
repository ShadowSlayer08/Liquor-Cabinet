{
  "name": "liquor-cabinet",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Liquor Cabinet — Android party planner: live Livcheers liquor prices, a food calculator, Zomato + Blinkit ordering.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/",
    "icons": "node scripts/make-icons.mjs",
    "sync": "vite build && npx cap sync android",
    "apk": "vite build && npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.34.0",
    "vite": "^8.3.1"
  }
}
