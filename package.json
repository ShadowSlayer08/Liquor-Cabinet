{
  "name": "liquor-cabinet",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "Liquor Cabinet — Android party planner: live Livcheers liquor prices, a food calculator, Zomato + Blinkit ordering.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.mjs\"",
    "icons": "node scripts/make-icons.mjs",
    "sync": "vite build && npx cap sync android",
    "apk": "vite build && npx cap sync android && node scripts/gradle.mjs assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/inappbrowser": "^4.0.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.34.0",
    "vite": "^8.3.1"
  }
}
